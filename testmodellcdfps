import pickle
import cv2
import mediapipe as mp
import numpy as np
from RPLCD.i2c import CharLCD
from time import sleep, time

# === Load Model ===
model_dict = pickle.load(open('./model.p', 'rb'))
model = model_dict['model']

# === Setup Camera ===
cap = cv2.VideoCapture(0)

# === Setup MediaPipe Hands ===
mp_hands = mp.solutions.hands
mp_drawing = mp.solutions.drawing_utils
mp_drawing_styles = mp.solutions.drawing_styles

hands = mp_hands.Hands(static_image_mode=False, min_detection_confidence=0.3)

# === Labels Dictionary ===
labels_dict = {
    0: 'A', 1: 'B', 2: 'C', 3: 'D',
    4: 'del', 5: 'E', 6: 'F', 7: 'G', 8: 'H', 9: 'I',
    10: 'J', 11: 'K', 12: 'L', 13: 'M', 14: 'N',
    15: 'nothing', 16: 'O', 17: 'P', 18: 'Q', 19: 'R', 20: 'S',
    21: 'space', 22: 'T', 23: 'U', 24: 'V', 25: 'W', 26: 'X', 27: 'Y', 28: 'Z'
}

# === Setup I2C LCD ===
lcd = CharLCD('PCF8574', 0x27)  # Adjust I2C address if needed

# === FPS Initialization ===
prev_time = time()
frame_count = 0  # Initialize frame_count here
prev_char = None

while True:
    data_aux = []
    x_ = []
    y_ = []

    ret, frame = cap.read()
    if not ret:
        break

    H, W, _ = frame.shape

    # Resize the frame for faster processing (e.g., to 320x240)
    frame_rgb = cv2.resize(frame, (320, 240))
    frame_rgb = cv2.cvtColor(frame_rgb, cv2.COLOR_BGR2RGB)

    # Skip processing some frames (every 2nd frame, for example)
    frame_count += 1
    if frame_count % 2 == 0:  # Change to 3 for every 3rd frame, etc.
        results = hands.process(frame_rgb)
        if results.multi_hand_landmarks:
            hand_landmarks = results.multi_hand_landmarks[0]  # Use only the first detected hand

            mp_drawing.draw_landmarks(
                frame,
                hand_landmarks,
                mp_hands.HAND_CONNECTIONS,
                mp_drawing_styles.get_default_hand_landmarks_style(),
                mp_drawing_styles.get_default_hand_connections_style())

            for i in range(len(hand_landmarks.landmark)):
                x = hand_landmarks.landmark[i].x
                y = hand_landmarks.landmark[i].y
                x_.append(x)
                y_.append(y)

            for i in range(len(hand_landmarks.landmark)):
                x = hand_landmarks.landmark[i].x
                y = hand_landmarks.landmark[i].y
                data_aux.append(x - min(x_))
                data_aux.append(y - min(y_))

            x1 = int(min(x_) * W) - 10
            y1 = int(min(y_) * H) - 10
            x2 = int(max(x_) * W) + 10
            y2 = int(max(y_) * H) + 10

            # Measure prediction time
            start = time()
            prediction = model.predict([np.asarray(data_aux)])
            print("Prediction time:", time() - start)
            predicted_character = labels_dict[int(prediction[0])]

            # === Draw prediction on screen ===
            cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 0, 0), 4)
            cv2.putText(frame, predicted_character, (x1, y1 - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 1.3, (0, 0, 0), 3, cv2.LINE_AA)

            # === Update LCD if the character has changed ===
            if predicted_character != prev_char:
                lcd.clear()
                lcd.write_string("You are saying:")
                lcd.cursor_pos = (1, 7)
                lcd.write_string(predicted_character)
                prev_char = predicted_character

    # === Calculate FPS ===
    curr_time = time()
    fps = 1 / (curr_time - prev_time)
    prev_time = curr_time

    # === Draw FPS on the frame ===
    cv2.putText(frame, f'FPS: {int(fps)}', (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)

    # === Show Frame ===
    cv2.imshow('frame', frame)

    # === Exit if 'q' is pressed ===
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
